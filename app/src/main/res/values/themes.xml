<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.PucContent" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#0E1A59</item>
        <item name="colorPrimaryVariant">#eff1f5</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" >?attr/colorPrimaryVariant</item>
        <item name="android:textColorSecondary">@color/black</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <!-- Customize your theme here. -->
        <item name="android:textViewStyle">@style/ReemKufiFontTextview</item>
        <item name="android:buttonStyle">@style/ReemKufiFontButton</item>
        <item name="android:background">#eff1f5</item>
        <item name="android:textColor">@color/black</item>
        <item name="myCardBackground">#fefeff</item>
        <item name="invertTheme">@color/black</item>
    </style>
    <style name="splashScreen" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/white</item>
    </style>
    <style name="fullScreen" parent="@style/Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
    <style name="MyActionBar" parent="@style/Theme.MaterialComponents.DayNight.DarkActionBar.Bridge">
        <item name="background">@color/blueOverlay</item>
        <item name="android:colorBackground">@color/blueOverlay</item>
    </style>
    <style name="ReemKufiFontTextview" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/reem_kufi</item>
    </style>

    <style name="ReemKufiFontButton" parent="android:Widget.Holo.Button">
        <item name="android:fontFamily">@font/reem_kufi</item>
    </style>
</resources>